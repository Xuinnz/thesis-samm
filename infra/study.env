# study.env -- the locked settings of the thesis runs on the VM (samm-bench,
# t2d-standard-4). server/scripts/study.sh sources this and nothing else, so a
# run never depends on what the shell that started it happened to export (a
# non-interactive ssh does not read ~/.bashrc).
#
# Every value here was decided before the main study and is recorded in
# docs/vm-test-plan.md with its date. Changing one changes the study: do it in
# a commit, with the reason, never on the command line.

# Load point: Phase 5, locked 2026-11-13.
STUDY_K=2.0

# Pinning (Phase 3): the OS on core 0, the server on core 1, k6 on cores 2-3.
CPUSET_CPUS=1
K6_TASKSET=2,3

# Host probe (Phase 3): the VM's own reference and k6 start-up limit.
PROBE_CPU=1
PROBE_REFERENCE="$REPO_ROOT/results/probe-reference-pooled"
K6_STARTUP_LIMIT_S=138
# Probe before the first replicate of every start, then every this many
# replicates (about every four hours), and at the end.
PROBE_EVERY=10

# SAMM's buffer mode: Phase 5 step 4, chosen 2026-11-13 on ten paired seeds.
SAMM_BUFFER_MODE=chunk

# Main study (Phase 9): n = 100, seeds 20250912 .. 20251011.
MAIN_N=100
MAIN_SEED=20250911
# Pilot: seeds 20261114, 20261115 (Phase 5's pilot seeds), apart from the main study's.
PILOT_N=2
PILOT_SEED=20261113
# GC pass: the main study's first replicates again, with the GC observer on.
GC_N=3
# The panel's extras (Phase 10): the same 15 seeds for every variant.
EXTRA_N=15
EXTRA_SEED=20261300
# The beta passes of each extra: seed 20261401, as in Phase 6.
BETA_SEED=20261400
